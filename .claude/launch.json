{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "outfits-dev-nokey",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev"
      ],
      "port": 3000,
      "env": {
        "OPENAI_API_KEY": ""
      }
    },
    {
      "name": "outfits-chatgpt-local",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev",
        "-p",
        "3200"
      ],
      "port": 3200,
      "url": "http://127.0.0.1:3200",
      "env": {
        "OPENAI_API_KEY": "",
        "NEXT_PUBLIC_SUPABASE_URL": "",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY": ""
      }
    },
    {
      "name": "outfits-ai-local",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "exec",
        "next",
        "start",
        "-p",
        "3100"
      ],
      "port": 3100,
      "env": {
        "LOCAL_PERSIST": "0",
        "NEXT_PUBLIC_SUPABASE_URL": "",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY": ""
      }
    }
  ]
}