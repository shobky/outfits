# Copy to .env.local:   cp .env.example .env.local
# Every variable is optional — with none set the app runs fully offline in demo mode.

# ── AI (the only thing you need for real styling) ───────────────────
# https://platform.openai.com/api-keys
# Without it: the scripted "Demo stylist" runs (no cost, no network).
OPENAI_API_KEY=

# Model for garment recognition when you upload photos (vision + structured output)
VISION_MODEL=gpt-5.4-mini
# Model for studio shots. About $0.025 per photo at the time of testing.
IMAGE_MODEL=gpt-image-2.5-sunburst
# Set to 0 to stop a premium feature for everyone at once. See docs/PREMIUM.md.
FEATURE_MULTI_PHOTO=
FEATURE_WORN_EXTRACT=
FEATURE_TRY_ON=
# Try-ons per person per day.
TRY_ON_DAILY_LIMIT=5
# Stylist messages per person per day. Resets at midnight UTC.
CHAT_DAILY_LIMIT=20
# Most photos per person per day, to cap spending on your key.
INTAKE_DAILY_PHOTO_LIMIT=60
# Studio shots per user, for life. After that, pieces use the owner's own photo.
STUDIO_FREE_SHOTS=15
# Total AI spend for everyone per day. When reached, studio and photo reading pause.
AI_DAILY_BUDGET_USD=5
# Set to 0 to turn studio shots off at once.
AI_STUDIO_ENABLED=1

# ── Local mode (no Supabase) ────────────────────────────────────────
# Your closet, outfits, chats and uploaded photos are saved to ./.data/ (gitignored).
# Set to 0 to keep everything in memory only.
LOCAL_PERSIST=1
# Set to 0 to start with an empty drawer instead of the sample pieces.
DEMO_SEED=1

# ── Supabase (optional — for sync across devices, login, deploying) ─
# Setup: docs/DEPLOY.md. When set, the app requires sign-in (magic link).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Comma-separated emails allowed in. Anyone can request a sign-in email, and the app
# spends on your API keys, so set this in production. Empty means anyone can use it.
ALLOWED_EMAILS=
# Set to 1 to admit people with an invite code as well as ALLOWED_EMAILS (docs/BETA.md).
INVITE_ONLY=
# Shown on the privacy page.
NEXT_PUBLIC_CONTACT_EMAIL=
# Set to 1 once custom SMTP sends a sign-in email containing {{ .Token }} (docs/DEPLOY.md).
NEXT_PUBLIC_AUTH_EMAIL_CODE=
# For scripts/import-local.mjs, and for "Continue with ChatGPT" on a copy using Supabase,
# which needs it to start a session. Never expose this one to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Sign in with ChatGPT ────────────────────────────────────────────
# Nothing to configure: no client ID, secret or API key. OpenAI only allows it from
# 127.0.0.1, so it appears when Outfits runs on your computer, not on a hosted deploy.
# See docs/CHATGPT.md.
